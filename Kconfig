#
# For a description of the syntax of this configuration file,
# see Documentation/kbuild/kconfig-language.txt.
#
mainmenu "$PACKAGE_NAME/$SRCARCH $ARCH $D $COMPILER Configuration on $PLATFORM"

config ARCH 
	string 
	option env="ARCH"
config SRCARCH
	string
	option env="SRCARCH"
config SUBARCH
        string
        option env="SUBARCH"
config HOST
	string
	option env="HOST"
config TARGET
        string
        option env="TARGET"
config PLATFORM
	string
	option env="PLATFORM"
config DEBUG
	string
	option env="DEBUG"
config COMPILER
	string
	option env="COMPILER"
config PACKAGE_NAME
	string
	option env="PACKAGE_NAME"

config SRCTREE
	string 
	option env="srctree"

menu "Architecture options"
source "arch/$SRCARCH/Kconfig"
source "arch/Kconfig"
endmenu

menu "Build options"
source "scripts/Kconfig.compiler"
source "scripts/Kconfig.debug"
endmenu

menu "Library options"

#
# The RCU flavour and the <hpc/conf.h> switch used to be spelled out here; they
# are in files of their own now, for the reason the memory options are.
#
source "Kconfig.rcu"
source "Kconfig.conf"

#
# Memory options — the slab reservation backend and the two madvise() hints
# over it. Kept in their own file (Kconfig.mem) so a tree that embeds this
# package sources the same definitions instead of keeping a copy of them in
# step by hand.
#
source "Kconfig.mem"

endmenu

menu "Module support"

config MODULES
	bool "Enable loadable module support"
	help
	  Modules are small pieces of compiled code which can be loaded
	  and unloaded into the running system. This allows extending
	  functionality without rebuilding the entire project.

	  If you say N here, all modules in the modules/ directory will
	  be compiled statically into the main binary with full inlining
	  for zero overhead.

	  If unsure, say N.

endmenu

